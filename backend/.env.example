# Supabase (spec/BDC RAG, conversations, review projects, session chunks)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret — Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Neo4j (schedule review + session GraphRAG — local Desktop instance or Aura)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o

# Key map geography (north/south of I-195)
# "hardcoded" (default) uses the built-in I-195 polyline; "hybrid_google" is
# reserved for a future Google-Geocoding sanity check and needs the API key.
GEO_REGION_VALIDATION=hardcoded
GOOGLE_MAPS_API_KEY=

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
