# Supabase (spec/BDC RAG, conversations, review projects, session chunks)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JWT Secret — Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Neo4j (schedule review + session GraphRAG — local Desktop instance or Aura)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o

# App
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
