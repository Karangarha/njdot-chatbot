# Copy to sandbox/.env  (./sandbox.sh init does this and, if the Supabase CLI
# is installed, fills the Supabase values from `supabase status`).

# ── Your local Supabase ──────────────────────────────────────────────────────
# URL as your browser sees it (becomes NEXT_PUBLIC_SUPABASE_URL).
SUPABASE_URL=http://127.0.0.1:54321
# Same Supabase as the backend container sees it.
SUPABASE_URL_FROM_DOCKER=http://host.docker.internal:54321
# anon / publishable key (becomes NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy HS256 JWT secret; the backend verifies ES256 tokens via JWKS first.
SUPABASE_JWT_SECRET=
# Postgres URL as a container sees it (used by db-apply / doctor).
SUPABASE_DB_URL_FROM_DOCKER=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# ── LLMs ─────────────────────────────────────────────────────────────────────
# Default: the bundled mock (free, deterministic). To use the real APIs,
# set real keys AND point the base URLs at the providers:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=sk-sandbox-mock
ANTHROPIC_API_KEY=sk-ant-sandbox-mock
OPENAI_BASE_URL=http://mock-llm:4010/v1
ANTHROPIC_BASE_URL=http://mock-llm:4010
LLM_PROVIDER=openai
CHAT_MODEL=gpt-4o

# ── Neo4j ────────────────────────────────────────────────────────────────────
# Bundled container by default. For Neo4j Desktop use
# NEO4J_URI=bolt://host.docker.internal:7687 and its password.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sandbox-neo4j-pw
NEO4J_DATABASE=neo4j

# ── Public URLs (what the browser uses) ──────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
MOCK_LLM_URL=http://localhost:4010

# ── Azure Web App "Startup Command" ──────────────────────────────────────────
# Set to exactly what the NJDOT Web App has in Configuration → General
# settings to reproduce production startup. The bare "uvicorn app.main:app ..."
# fails in the App Service runtime ("uvicorn: not found") — see backend/Dockerfile.
# AZURE_STARTUP_COMMAND=python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
